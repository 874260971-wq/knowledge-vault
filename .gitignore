# ============================================================
# Obsidian Vault .gitignore
# ============================================================
# 作用：把知识库 git 化时，避免把本地缓存、设备专属状态、临时文件误入 git。
# 配套：vault 根目录作为 git 仓库，配合 obsidian-git 插件使用。

# ---------- Obsidian 本地状态（不入版本库）----------
.obsidian/workspace
.obsidian/workspace.json
.obsidian/cache/
.obsidian/plugins/*/data.json
.obsidian/plugins/obsidian-git/data.json
.trash/

# ---------- WorkBuddy 项目记忆（不入 vault）----------
.workbuddy/
# 解释：.workbuddy/ 是 WorkBuddy 的项目级记忆目录，由 WorkBuddy 自己维护，
# 不属于 Obsidian 知识本身。多设备同步知识库时不需要它。

# ---------- 操作系统临时文件 ----------
.DS_Store
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/
*~

# ---------- 编辑器 / IDE ----------
.vscode/
.idea/
*.swp
*.swo
*.swn

# ---------- 日志 ----------
*.log

# ---------- 画板备份（Obsidian Canvas 主文件 .base 保留）----------
*.base.bak